VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Set to "true" in a local .env.local (never .env) to point the
# app at the local Firebase Emulator Suite (Auth/Firestore/Functions)
# instead of the real project. Leave unset for normal development.
VITE_USE_FIREBASE_EMULATOR=
