rules_version = '2';

// ARConnect — Firestore Security Rules
//
// Paste this into Firebase Console → Firestore Database → Rules → Publish
// (or `firebase deploy --only firestore:rules` if you use the CLI).
//
// This is the Firestore-native equivalent of what a Postgres RLS policy +
// trigger would do: users can only ever read or update their own profile
// document, can never set their own role to 'admin' (or change role at all
// once created), and can never delete it. Every other collection is
// default-denied until a later phase defines rules for it — nothing in
// this app should be readable/writable until it's explicitly allowed here.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Reads the requester's OWN role off their users/{uid} doc. Only ever
    // called with request.auth.uid, so this is just isOwner's read rule
    // applied to the caller themselves — it doesn't let anyone read a
    // DIFFERENT user's role, since a get() here still goes through no
    // rule of its own (get()/exists() inside rules bypass rule evaluation
    // by design, but the path is always the caller's own uid).
    function callerRole() {
      return callerProfile().role;
    }

    // Full profile of the caller (their own users/{uid} doc). Used to
    // verify a candidate's applications carry their REAL name/email,
    // never client-supplied free text impersonating someone else.
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Absent on every user created before Phase 9 — .get(key, default)
    // treats "field missing" and "explicitly active" as the same thing,
    // both here and in the users/{uid} update rule below, so existing
    // accounts never need a backfill write to be correctly "active".
    function callerModerationStatus() {
      return callerProfile().get('moderationStatus', 'active');
    }

    function isNotSuspended() {
      return callerModerationStatus() != 'suspended';
    }

    // users/{uid} — one profile document per authenticated user.
    match /users/{userId} {
      // Admins can read any user's profile — Phase 5's Users/Candidates/
      // Employers pages need this. callerRole() is the same trusted,
      // server-verified read used everywhere else in this file: it reads
      // the CALLER's own users/{uid}.role, which the create/update rules
      // just below make immutable to anything but 'candidate'/'employer'
      // at signup — there is no client path that ever sets it to 'admin',
      // so this OR-clause can never be satisfied by a self-declared claim.
      allow read: if isOwner(userId) || callerRole() == 'admin';

      // Only ever created by the client immediately after signup, for
      // themselves, and only ever as 'candidate' or 'employer' — 'admin'
      // can never be set this way, no matter what the client sends.
      allow create: if isOwner(userId)
        && request.resource.data.role in ['candidate', 'employer'];

      // Any other field (full_name, phone, avatar_url, ...) may be updated
      // by the owner, but role must stay exactly what it already was —
      // this is what makes privilege escalation from the browser
      // impossible. To promote a user to admin, edit the document directly
      // in the Firebase Console (which runs with full access, bypassing
      // these rules) — there is deliberately no client-facing way to do it.
      // moderationStatus is pinned here too (via the same default-aware
      // accessor) so a candidate/employer editing their own phone number
      // can never sneak a status change through this path — Phase 9's
      // admin-only branch below is the only way it can ever move.
      allow update: if
        (
          isOwner(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('moderationStatus', 'active') == resource.data.get('moderationStatus', 'active')
        )
        ||
        (
          // Admin moderation: the ONLY thing this path may ever change is
          // moderationStatus. Every other field — role, full_name, email,
          // phone, avatar_url, created_at — is pinned explicitly equal, so
          // an admin can suspend/unsuspend an account but can never touch
          // its identity or role through this feature. request.auth.uid
          // != userId is a hard, rules-level "cannot suspend yourself" —
          // not just a disabled button in the UI.
          callerRole() == 'admin'
          && request.auth.uid != userId
          && request.resource.data.get('moderationStatus', 'active') in ['active', 'suspended']
          && request.resource.data.role == resource.data.role
          && request.resource.data.full_name == resource.data.full_name
          && request.resource.data.email == resource.data.email
          // .get(key, default) rather than direct field access — phone
          // and avatar_url are optional/nullable and a direct
          // resource.data.phone access throws (denying the whole write)
          // on any document where the field is genuinely absent, not
          // just null.
          && request.resource.data.get('phone', null) == resource.data.get('phone', null)
          && request.resource.data.get('avatar_url', null) == resource.data.get('avatar_url', null)
          && request.resource.data.created_at == resource.data.created_at
        );

      allow delete: if false;
    }

    // Reads a job's real data for cross-checking against what a candidate's
    // application claims about it (employerId, title, companyName) — closes
    // off forging an application that impersonates a different employer's
    // job than the one actually being applied to.
    function jobFor(jobId) {
      return get(/databases/$(database)/documents/jobs/$(jobId)).data;
    }

    // jobs/{jobId} — public listings, owned by the employer who posted them.
    match /jobs/{jobId} {
      allow read: if true;

      allow create: if isSignedIn()
        && isNotSuspended()
        && callerRole() == 'employer'
        && request.resource.data.employerId == request.auth.uid
        && request.resource.data.applicationCount == 0;

      allow update: if isSignedIn() && (
        // The owning employer may change anything (title, salary, status,
        // ...) EXCEPT employerId — ownership can never be reassigned, even
        // by the current owner, even accidentally. A suspended employer
        // loses this path entirely (Phase 9) — they can't edit, close, or
        // reopen their own jobs while suspended; only admin still can.
        (
          callerRole() == 'employer'
          && isNotSuspended()
          && resource.data.employerId == request.auth.uid
          && request.resource.data.employerId == resource.data.employerId
        )
        ||
        // The only other party ever allowed to touch a job document is a
        // candidate applying to it — and the only thing they may do is
        // bump applicationCount by exactly one, paired atomically (in the
        // same batch) with creating their own applications/{id} doc. This
        // is what makes "delete only if zero applications" a real,
        // server-enforced guarantee below, not just a client-side check a
        // malicious client could skip. employerId and status are checked
        // explicitly immutable here (ownership can't be hijacked, lifecycle
        // can't be silently flipped) rather than via a generic
        // diff()/hasOnly() field-allowlist.
        (
          callerRole() == 'candidate'
          && isNotSuspended()
          && request.resource.data.applicationCount == resource.data.applicationCount + 1
          && request.resource.data.employerId == resource.data.employerId
          && request.resource.data.status == resource.data.status
        )
        ||
        // Phase 9 admin moderation: the ONLY thing this path may ever
        // change is status (active/closed) — ownership and application
        // history (applicationCount) are pinned explicitly equal, so an
        // admin closing a problematic job can never reassign it or touch
        // its application count.
        (
          callerRole() == 'admin'
          && request.resource.data.status in ['active', 'closed']
          && request.resource.data.employerId == resource.data.employerId
          && request.resource.data.applicationCount == resource.data.applicationCount
        )
      );

      // Hard delete only permitted once applicationCount is back to zero —
      // preserves application history for any job that was ever applied
      // to. The UI only ever offers Close for such jobs, but this is the
      // actual enforcement: even a direct deleteDoc() call bypassing the
      // UI is rejected the same way. A suspended employer cannot delete
      // their own jobs either (Phase 9).
      allow delete: if isSignedIn()
        && isNotSuspended()
        && callerRole() == 'employer'
        && resource.data.employerId == request.auth.uid
        && resource.data.applicationCount == 0;
    }

    // applications/{candidateId}_{jobId} — composite id makes the doc id
    // itself the duplicate-application guard: a candidate can only ever
    // create ONE document for a given (candidateId, jobId) pair, because
    // Firestore doc ids are unique and this rule forces the id to encode
    // exactly that pair.
    match /applications/{applicationId} {
      // Admins can read any application — Phase 5's Applications page (and
      // the per-employer job counts on the Employers page) need this. Same
      // callerRole()-based trust as the users/{uid} admin read above.
      allow read: if isSignedIn() && (
        resource.data.candidateId == request.auth.uid ||
        (callerRole() == 'employer' && resource.data.employerId == request.auth.uid) ||
        callerRole() == 'admin'
      );

      // Every denormalized field here is verified against the real source
      // document, not trusted from the client: employerId/jobTitle/
      // companyName must match the actual job being applied to (so a
      // candidate can never forge an application that shows up in a
      // DIFFERENT employer's inbox than the job they really applied to),
      // and candidateName/candidateEmail must match the applicant's own
      // profile (so an employer can never be shown a spoofed identity).
      // Phase 9: a job an admin (or its own employer) has closed can no
      // longer receive new applications — this was never actually
      // enforced anywhere before Phase 9 added admin job moderation, so
      // it's a genuine tightening, not a pre-existing guarantee.
      allow create: if isSignedIn()
        && isNotSuspended()
        && jobFor(request.resource.data.jobId).status == 'active'
        && request.resource.data.candidateId == request.auth.uid
        && applicationId == request.auth.uid + '_' + request.resource.data.jobId
        && request.resource.data.status == 'applied'
        && request.resource.data.employerId == jobFor(request.resource.data.jobId).employerId
        && request.resource.data.jobTitle == jobFor(request.resource.data.jobId).title
        && request.resource.data.companyName == jobFor(request.resource.data.jobId).companyName
        && request.resource.data.candidateName == callerProfile().full_name
        && request.resource.data.candidateEmail == callerProfile().email;

      // The owning employer may change status (+ updatedAt) — every other
      // field, including candidateId/jobId/employerId, is checked
      // explicitly immutable here (rather than via a generic
      // diff()/hasOnly() field-allowlist), so they can never be touched by
      // anyone, including the owning employer. Phase 12: once a candidate
      // has withdrawn, the employer branch is no longer available at all
      // (resource.data.status != 'withdrawn') — there's nothing left for
      // an employer to decide on a withdrawn application.
      //
      // Phase 14: deliberately NO from-state lock among the six employer
      // statuses below (applied/reviewing/shortlisted/interview/rejected/
      // hired) — unlike interviews.update's terminal-state lock, the
      // employer UI (ApplicationRow, used on 3 pages) already lets an
      // employer move freely in either direction between all six, e.g. to
      // undo a mis-click or reconsider a rejected/hired candidate. That's
      // existing, intentional product behavior, not a missing guard —
      // confirmed by inspection before adding this note. Only `withdrawn`
      // is actually terminal here (see above and the candidate branch
      // below).
      allow update: if isSignedIn() && (
        (
          isNotSuspended()
          && callerRole() == 'employer'
          && resource.data.employerId == request.auth.uid
          && resource.data.status != 'withdrawn'
          && request.resource.data.status in ['applied', 'reviewing', 'shortlisted', 'interview', 'rejected', 'hired']
          && request.resource.data.candidateId == resource.data.candidateId
          && request.resource.data.jobId == resource.data.jobId
          && request.resource.data.employerId == resource.data.employerId
          && request.resource.data.candidateName == resource.data.candidateName
          && request.resource.data.candidateEmail == resource.data.candidateEmail
          && request.resource.data.jobTitle == resource.data.jobTitle
          && request.resource.data.companyName == resource.data.companyName
          && request.resource.data.appliedAt == resource.data.appliedAt
        )
        ||
        (
          // Phase 12: a candidate may withdraw their OWN application — the
          // ONLY status transition this branch permits is to 'withdrawn',
          // and only from a still-open state (never from rejected/hired,
          // which are final employer decisions, and never from an already-
          // withdrawn application). Every other field is pinned exactly
          // like the employer branch above, so this can never become a
          // back door for a candidate to touch anything else about their
          // own application.
          isNotSuspended()
          && resource.data.candidateId == request.auth.uid
          && resource.data.status in ['applied', 'reviewing', 'shortlisted', 'interview']
          && request.resource.data.status == 'withdrawn'
          && request.resource.data.candidateId == resource.data.candidateId
          && request.resource.data.jobId == resource.data.jobId
          && request.resource.data.employerId == resource.data.employerId
          && request.resource.data.candidateName == resource.data.candidateName
          && request.resource.data.candidateEmail == resource.data.candidateEmail
          && request.resource.data.jobTitle == resource.data.jobTitle
          && request.resource.data.companyName == resource.data.companyName
          && request.resource.data.appliedAt == resource.data.appliedAt
        )
      );

      allow delete: if false;
    }

    // savedJobs/{candidateId}_{jobId} — same composite-id pattern as
    // applications, for the same reason (structurally prevents duplicate
    // saves of the same job by the same candidate).
    match /savedJobs/{savedJobId} {
      allow read: if isSignedIn() && resource.data.candidateId == request.auth.uid;

      allow create: if isSignedIn()
        && isNotSuspended()
        && request.resource.data.candidateId == request.auth.uid
        && savedJobId == request.auth.uid + '_' + request.resource.data.jobId;

      allow delete: if isSignedIn() && isNotSuspended() && resource.data.candidateId == request.auth.uid;

      allow update: if false;
    }

    // candidateProfiles/{uid} — matching-relevant profile data (skills,
    // experience, location, preferences). Kept as its own collection
    // rather than added to users/{uid}, which every phase so far has left
    // untouched — this is genuinely new data, not an extension of auth
    // identity basics.
    match /candidateProfiles/{userId} {
      allow read: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && isNotSuspended()
        && request.resource.data.candidateId == userId;

      allow delete: if false;
    }

    // matches/{candidateId}_{jobId} — AI match results. No client write
    // path exists here at all, for anyone, ever: create/update/delete are
    // unconditionally false. Only the computeMatch Cloud Function (Admin
    // SDK, which bypasses these rules entirely) ever writes this
    // collection. That's what makes "client cannot create a fake score,
    // modify a score, modify an explanation, or touch someone else's
    // match" a structural impossibility rather than a policy this file
    // has to carefully enforce.
    match /matches/{matchId} {
      allow read: if isSignedIn() && (
        resource.data.candidateId == request.auth.uid ||
        (callerRole() == 'employer' && resource.data.employerId == request.auth.uid)
      );

      allow create, update, delete: if false;
    }

    // companyProfiles/{uid} — PRIVATE employer company data, including
    // contact details. Never exposed to candidates or other employers.
    // Firestore rules can only grant/deny read access to a whole document,
    // never redact individual fields per-reader — that's why the public,
    // candidate-facing view lives in a SEPARATE collection (companySummaries,
    // below) rather than trying to carve exceptions into this one.
    match /companyProfiles/{userId} {
      allow read: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && isNotSuspended()
        && callerRole() == 'employer'
        && request.resource.data.employerId == userId;

      allow delete: if false;
    }

    // companySummaries/{uid} — the public-safe subset of a company's
    // profile (never contactEmail/contactPhone), keyed by the same uid so
    // a job's employerId can look one up directly. Publicly readable, same
    // openness as jobs/{jobId} itself — a candidate should be able to see
    // basic company info before ever deciding to apply. The
    // contactEmail/contactPhone exclusion is enforced structurally, not
    // just by client convention: no write containing either field can
    // ever succeed here, regardless of what a buggy or malicious client
    // sends.
    match /companySummaries/{userId} {
      allow read: if true;

      allow create, update: if isOwner(userId)
        && isNotSuspended()
        && callerRole() == 'employer'
        && request.resource.data.employerId == userId
        && !('contactEmail' in request.resource.data)
        && !('contactPhone' in request.resource.data);

      allow delete: if false;
    }

    // Reads a real application's data to validate a notification that
    // references it — the same jobFor()-style pattern used by
    // applications/{id}.create above, applied here so a notification's
    // recipientId can never be a bare client claim.
    function applicationFor(applicationId) {
      return get(/databases/$(database)/documents/applications/$(applicationId)).data;
    }

    // Same pattern, for interview-related notifications (Phase 10).
    function interviewFor(interviewId) {
      return get(/databases/$(database)/documents/interviews/$(interviewId)).data;
    }

    // notifications/{notificationId} — always created as a SEPARATE write
    // after the real action (application create, status update) has
    // already committed, never in the same batch — Firestore rules
    // evaluate get() against already-persisted state, not sibling writes
    // in the same batch, so validating against a same-batch document
    // isn't possible. The one consequence: a notification write could in
    // theory fail even though the underlying action succeeded (a rare
    // network blip) — acceptable, since the action itself is unaffected
    // and a missing "nice to have" notification isn't a security issue.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;

      // Every create path below ties recipientId to something real and
      // verifiable — never a bare claim — so a user can never generate a
      // notification for an arbitrary recipient:
      allow create: if isSignedIn() && (
        // 1. A candidate confirms their OWN application was submitted.
        (
          request.resource.data.recipientId == request.auth.uid
          && request.resource.data.type == 'application_submitted_confirmation'
        )
        ||
        // 2. A candidate notifies the REAL employer of a REAL application
        //    they actually own — recipientId is read off that
        //    already-persisted application, not supplied by the client.
        (
          callerRole() == 'candidate'
          && request.resource.data.type == 'new_application'
          && applicationFor(request.resource.data.relatedApplicationId).candidateId == request.auth.uid
          && applicationFor(request.resource.data.relatedApplicationId).jobId == request.resource.data.relatedJobId
          && request.resource.data.recipientId == applicationFor(request.resource.data.relatedApplicationId).employerId
        )
        ||
        // 3. An employer notifies the REAL candidate of a REAL application
        //    they actually own — same pattern, mirrored.
        (
          callerRole() == 'employer'
          && request.resource.data.type == 'application_status_updated'
          && applicationFor(request.resource.data.relatedApplicationId).employerId == request.auth.uid
          && request.resource.data.recipientId == applicationFor(request.resource.data.relatedApplicationId).candidateId
        )
        ||
        // 4. Phase 10: an employer notifies the REAL candidate of a REAL
        //    interview they actually own — same pattern again, this time
        //    verified against the interviews collection instead of
        //    applications.
        (
          callerRole() == 'employer'
          && request.resource.data.type in ['interview_scheduled', 'interview_updated', 'interview_cancelled']
          && interviewFor(request.resource.data.relatedInterviewId).employerId == request.auth.uid
          && request.resource.data.recipientId == interviewFor(request.resource.data.relatedInterviewId).candidateId
        )
        ||
        // 5. Phase 12: a candidate notifies the REAL employer that they
        //    withdrew a REAL application they actually own — same
        //    applicationFor()-verified pattern as branch 2, mirrored.
        (
          callerRole() == 'candidate'
          && request.resource.data.type == 'application_withdrawn'
          && applicationFor(request.resource.data.relatedApplicationId).candidateId == request.auth.uid
          && applicationFor(request.resource.data.relatedApplicationId).jobId == request.resource.data.relatedJobId
          && request.resource.data.recipientId == applicationFor(request.resource.data.relatedApplicationId).employerId
        )
      );

      // Only the recipient may ever touch their own notification, and
      // only to flip `read` — every other field is permanently immutable
      // (explicit equality checks, same style as applications/{id}.update
      // above, rather than a generic diff()/hasOnly() allowlist).
      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.type == resource.data.type
        && request.resource.data.title == resource.data.title
        && request.resource.data.message == resource.data.message
        && request.resource.data.relatedJobId == resource.data.relatedJobId
        && request.resource.data.relatedApplicationId == resource.data.relatedApplicationId
        // .get(key, null) — most notifications (Phase 8 types) never had
        // this field at all; Phase 10's interview types are the first to
        // set it. Default-aware access keeps both cases correctly pinned
        // without throwing on documents where the field is absent.
        && request.resource.data.get('relatedInterviewId', null) == resource.data.get('relatedInterviewId', null)
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // moderationLogs/{logId} — an immutable audit trail of every
    // moderation action. Create-only, admin-only, and the create rule
    // needs no cross-document get() at all (unlike notifications), so
    // moderationService.js writes the target-doc change and the log
    // entry together in ONE atomic batch: a log exists if and only if
    // the action it documents actually happened.
    match /moderationLogs/{logId} {
      allow read: if isSignedIn() && callerRole() == 'admin';

      allow create: if isSignedIn()
        && callerRole() == 'admin'
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.action in [
          'user_suspended', 'user_unsuspended', 'job_closed', 'job_reopened',
          'report_reviewed', 'report_dismissed'
        ]
        && request.resource.data.targetType in ['user', 'job', 'report']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 500;

      // No UI ever offers editing or deleting a log entry, and this is
      // the actual enforcement — even a direct call bypassing the UI is
      // rejected the same way.
      allow update, delete: if false;
    }

    // reports/{reportId} — a candidate/employer flagging a job or user for
    // admin attention. Once submitted, the reporter has no further access
    // to it at all (no update, no delete) — only admin can ever read or
    // change it, and even admin may only move `status` and set
    // `reviewedBy`/`reviewedAt`; every submission-time field is pinned.
    match /reports/{reportId} {
      allow read: if isSignedIn() && callerRole() == 'admin';

      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['user', 'job']
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 500
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000;

      allow update: if isSignedIn()
        && callerRole() == 'admin'
        && request.resource.data.status in ['reviewed', 'dismissed']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reporterId == resource.data.reporterId
        && request.resource.data.targetType == resource.data.targetType
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.description == resource.data.description
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // Shared validation for interview create/update — enum values, a
    // sane duration bound, bounded notes, and the type-conditional
    // meetingLink/location requirements from Part 3. Kept as one function
    // so create and update can never drift apart on what "a valid
    // interview" means.
    function validInterviewFields(data) {
      return data.interviewType in ['online', 'phone', 'in_person']
        && data.status in ['scheduled', 'completed', 'cancelled']
        && data.scheduledAt is timestamp
        && data.durationMinutes is int
        && data.durationMinutes > 0
        && data.durationMinutes <= 480
        && data.notes is string
        && data.notes.size() <= 1000
        && (data.interviewType != 'online' || (data.meetingLink is string && data.meetingLink.matches('^https://.*')))
        && (data.interviewType != 'in_person' || (data.location is string && data.location.size() >= 3 && data.location.size() <= 200));
    }

    // interviews/{interviewId} — scheduled by the employer who owns the
    // underlying application; the candidate is always read-only. No admin
    // clause: Phase 5-9 never needed one for this kind of scoped,
    // two-party data, and nothing in Phase 10 asks for one either.
    match /interviews/{interviewId} {
      allow read: if isSignedIn() && (
        resource.data.candidateId == request.auth.uid ||
        (callerRole() == 'employer' && resource.data.employerId == request.auth.uid)
      );

      // candidateId/jobId are never taken from the client — they're read
      // off the REAL application document being scheduled against, the
      // same jobFor()/applicationFor() trust pattern used everywhere else
      // in this file. This is what makes "spoof candidateId" or "schedule
      // for an application you don't own" structurally impossible rather
      // than a check that has to get every field right.
      // Phase 13: a withdrawn application has nothing left to interview
      // for — the same applicationFor() read already used for ownership
      // also rules out scheduling a brand-new interview against it.
      allow create: if isSignedIn()
        && isNotSuspended()
        && callerRole() == 'employer'
        && request.resource.data.employerId == request.auth.uid
        && applicationFor(request.resource.data.applicationId).employerId == request.auth.uid
        && applicationFor(request.resource.data.applicationId).status != 'withdrawn'
        && request.resource.data.candidateId == applicationFor(request.resource.data.applicationId).candidateId
        && request.resource.data.jobId == applicationFor(request.resource.data.applicationId).jobId
        && request.resource.data.status == 'scheduled'
        && validInterviewFields(request.resource.data);

      // Edit/cancel/mark-completed all go through this one path — every
      // ownership field (employerId/candidateId/applicationId/jobId) is
      // pinned explicitly equal, so an employer can freely change the
      // schedule, type, or status of their OWN interview but can never
      // reassign it to a different application, candidate, or job.
      //
      // Phase 13 adds two independent status-transition constraints,
      // combined as OR-branches (same style as every multi-case rule in
      // this file) rather than a single tangled condition:
      //
      //   1. If the parent application has been withdrawn, the only
      //      surviving action is cancelling the interview — no reschedule/
      //      field edit (status would stay 'scheduled', which this branch
      //      does not permit) and no marking it completed.
      //   2. Otherwise, status may only move forward: 'scheduled' can
      //      become 'completed' or 'cancelled', or stay 'scheduled' (a
      //      plain edit). Once 'completed' or 'cancelled', status can
      //      never change again in either direction — closes the Phase 10
      //      gap where a terminal interview status wasn't actually
      //      terminal at the rules level.
      allow update: if isSignedIn()
        && isNotSuspended()
        && callerRole() == 'employer'
        && resource.data.employerId == request.auth.uid
        && request.resource.data.employerId == resource.data.employerId
        && request.resource.data.candidateId == resource.data.candidateId
        && request.resource.data.applicationId == resource.data.applicationId
        && request.resource.data.jobId == resource.data.jobId
        && request.resource.data.createdAt == resource.data.createdAt
        && validInterviewFields(request.resource.data)
        && (
          (
            applicationFor(resource.data.applicationId).status == 'withdrawn'
            && resource.data.status == 'scheduled'
            && request.resource.data.status == 'cancelled'
          )
          ||
          (
            applicationFor(resource.data.applicationId).status != 'withdrawn'
            && (
              request.resource.data.status == resource.data.status
              || (resource.data.status == 'scheduled' && request.resource.data.status in ['completed', 'cancelled'])
            )
          )
        );

      // Never hard-deleted — cancelling sets status: 'cancelled' instead,
      // preserving the record (Part 10: "existing interview data must
      // remain intact").
      allow delete: if false;
    }

    // Everything else (messages, ...) is not implemented yet —
    // default-deny until each collection gets its own rules in a later
    // phase.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
