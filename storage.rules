rules_version = '2';

// ARConnect — Firebase Storage Security Rules
//
// The only feature currently using Storage is candidate resume upload.
// Same least-privilege posture as firestore.rules: a candidate can only
// ever read/write/delete their OWN resume file via this Storage read rule,
// nothing else exists here, and everything else is default-denied.
//
// Employer resume visibility is intentionally NOT implemented as a Storage
// rule change: an employer never reads this path directly. Instead, the
// candidate's resumeFileUrl/resumeFileName are copied onto their
// applications/{applicationId} document at apply time and pinned immutable
// there (see firestore.rules' applications.create/update, which
// cross-verifies both fields against the candidate's own candidateProfiles
// doc via candidateProfileFor() — never a bare client claim). The employer
// who already legitimately reads that application (per applications.read,
// scoped to their own jobs) reads the resume link along with it. Storage
// itself stays owner-only exactly as before.
service firebase.storage {
  match /b/{bucket}/o {

    // resumes/{userId}/{fileName} — one candidate's resume file(s).
    // fileName is timestamp-prefixed by the client (see resumeService.js)
    // so replacing a resume writes a new object rather than colliding with
    // the old one; the old one is deleted separately after the new upload
    // succeeds.
    match /resumes/{userId}/{fileName} {
      // Only the owning candidate can ever read their own resume back —
      // matches candidateProfiles/{uid}'s owner-only read in firestore.rules.
      allow read: if request.auth != null && request.auth.uid == userId;

      // Content-type and size are enforced here, server-side — the
      // client-side check in src/lib/resumeValidation.js is a friendly
      // first line, not the real boundary, same relationship every other
      // form in this app has with its own rules-layer backstop.
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        ];

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Default-deny everything else — same philosophy as firestore.rules'
    // catch-all: nothing is readable/writable until explicitly allowed
    // above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
